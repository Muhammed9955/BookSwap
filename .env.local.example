# ============================================================
# BookSwap Egypt — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.

# ============================================================
# SUPABASE
# ============================================================
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BookSwap
NEXT_PUBLIC_APP_NAME_AR=بدّلها

# ============================================================
# ADMIN
# ============================================================
# Email of the initial admin account
# After creating an account with this email, run the SQL:
# UPDATE profiles SET role = 'ADMIN' WHERE id = (SELECT id FROM auth.users WHERE email = 'your-admin@email.com');
ADMIN_EMAIL=admin@bookswap.eg

# ============================================================
# GOOGLE OAUTH (optional)
# ============================================================
# Configure in Supabase Authentication > Providers > Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ============================================================
# OPEN LIBRARY API (for book metadata lookup)
# ============================================================
# No key needed — Open Library is free
NEXT_PUBLIC_OPEN_LIBRARY_API=https://openlibrary.org

# ============================================================
# GOOGLE BOOKS API (optional, for better coverage)
# ============================================================
# GOOGLE_BOOKS_API_KEY=

# ============================================================
# GOOGLE TAG & ANALYTICS (Optional for Tracking & SEO)
# ============================================================
# 1. Google Analytics 4 (GA4): Measurement ID from Google Analytics (Admin > Data Streams)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 2. Google Tag Manager (GTM): Container ID (optional if using GA4 directly)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# 3. Google Search Console Site Verification:
# Value of the google-site-verification HTML tag or token
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# ============================================================
# STORAGE
# ============================================================
# Supabase Storage bucket names (create these in Supabase dashboard)
NEXT_PUBLIC_BUCKET_BOOK_IMAGES=book-images
NEXT_PUBLIC_BUCKET_AVATARS=avatars
